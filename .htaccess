# Web7 Clock - Apache 設定（ロリポップ: ~/web/ai-services/clock/ 配下に配置）
# 目的: 転送量削減とキャッシュ制御による表示速度（Core Web Vitals）改善。
# 各ブロックは <IfModule> で囲んでいるため、モジュール未搭載の環境でも 500 にはなりません。

# --- MIME タイプ / 文字コード -------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .html .css .js .txt .xml .svg
</IfModule>

AddDefaultCharset UTF-8

# --- gzip 圧縮 ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- ブラウザキャッシュ --------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML は常に最新を取得させる（時計デザイン追加を即反映するため）
  ExpiresByType text/html "access plus 0 seconds"

  # クロール制御ファイルは短め
  ExpiresByType text/plain "access plus 1 hours"
  ExpiresByType application/xml "access plus 1 hours"

  # 静的アセットは長め
  ExpiresByType text/css "access plus 1 weeks"
  ExpiresByType application/javascript "access plus 1 weeks"
  ExpiresByType image/svg+xml "access plus 1 months"
  ExpiresByType image/png "access plus 1 months"
  ExpiresByType image/jpeg "access plus 1 months"
  ExpiresByType image/webp "access plus 1 months"
  ExpiresByType font/woff2 "access plus 1 years"
  ExpiresByType application/manifest+json "access plus 1 hours"
</IfModule>

<IfModule mod_headers.c>
  # HTML は毎回検証させる
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # robots.txt / sitemap.xml / llms.txt は更新をすぐ拾わせる
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Service Worker は絶対にキャッシュさせない。
  # ここをキャッシュすると更新版のSWが配信されず、古いアセットが残り続ける。
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>

  # マニフェストは短めに（インストール情報の更新を拾わせる）
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# --- ディレクトリ一覧の抑止 ----------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
